{
  "name": "reverse-turing",
  "pages_build_output_dir": "./dist-pages",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reverse-turing",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}
